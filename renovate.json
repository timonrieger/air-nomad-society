{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "schedule:monthly"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "uv toolchain",
      "groupSlug": "uv",
      "matchPackageNames": [
        "uv",
        "astral-sh/uv-pre-commit"
      ]
    }
  ]
}

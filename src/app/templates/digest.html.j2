<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>Your weekly flight deals</title>
  <!--[if !mso]><!-->
  <link href="https://api.fonts.coollabs.io/css2?family=Bitter:wght@400;600;700&display=swap" rel="stylesheet" type="text/css">
  <!--<![endif]-->
</head>

{% from "_macros.html.j2" import button, eyebrow with context %}

{% macro deal_card(flight) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <tr>
    <td style="background-color: {{ t.gray_100 }}; border-radius: 12px;">
      <img src="{{ flight.image_url }}" alt="{{ flight.deal.arrival_city }}, {{ flight.deal.arrival_country }}" width="600" style="display: block; width: 100%; height: 240px; object-fit: cover; border: 0; border-radius: 12px 12px 0 0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding: 20px 24px 24px;">
            <p style="margin: 0 0 10px;">{% for badge in flight.badges %}<span style="display: inline-block; background-color: #ffffff; border: 1px solid {{ t.gray_200 }}; border-radius: 999px; font-family: {{ t.font }}; font-size: 12px; font-weight: 600; color: {{ t.gray_800 }}; padding: 3px 12px; margin-right: 6px;">{{ badge }}</span>{% endfor %}</p>
            <p style="margin: 0 0 4px; font-family: {{ t.font }}; font-size: 20px; font-weight: 700; color: {{ t.gray_900 }};">{{ flight.deal.departure_city }} &ndash; {{ flight.deal.arrival_city }}</p>
            <p style="margin: 0 0 4px; font-family: {{ t.font }}; font-size: 14px; color: {{ t.gray_500 }};">{{ flight.deal.arrival_country }} &middot; {{ flight.dates }}</p>
            <p style="margin: 0 0 {{ "4px" if flight.reason else "16px" }}; font-family: {{ t.font }}; font-size: 13px; color: {{ t.gray_500 }};">{{ flight.facts }}</p>
            {% if flight.reason %}<p style="margin: 0 0 16px; font-family: {{ t.font }}; font-size: 13px; font-style: italic; color: {{ t.gray_800 }};">{{ flight.reason }}</p>{% endif %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="vertical-align: middle;">
                  <strong style="font-family: {{ t.font }}; font-size: 22px; font-weight: 700; color: {{ t.accent }};">{{ flight.deal.price | int }} {{ flight.deal.currency }}</strong>
                  {% if flight.anchor %}<p style="margin: 2px 0 0; font-family: {{ t.font }}; font-size: 13px; color: {{ t.gray_500 }};">{{ flight.anchor }}</p>{% endif %}
                </td>
                <td align="right" style="vertical-align: middle;">
                  {{ button(flight.deal.link, "Book Now") }}
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{%- endmacro %}

<body style="margin: 0; padding: 0; background-color: #ffffff; -webkit-text-size-adjust: none; text-size-adjust: none;">
  <div style="display: none; max-height: 0; overflow: hidden;">Your weekly flight deals are here.</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #ffffff;">
    <tr>
      <td align="center" style="padding: 0 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; text-align: left;">
          <tr>
            <td style="padding: 48px 0 40px;">
              {{ eyebrow() }}
              <h1 style="margin: 0; font-family: {{ t.font }}; font-size: 32px; font-weight: 700; line-height: 1.2; color: {{ t.gray_900 }};">Hi {{ username }}!</h1>
              <p style="margin: 12px 0 0; font-family: {{ t.font }}; font-size: 16px; line-height: 1.5; color: {{ t.gray_500 }};">Here are this week's flight deals, picked for you.</p>
            </td>
          </tr>
          <tr>
            <td>
              <h2 style="margin: 0 0 16px; font-family: {{ t.font }}; font-size: 22px; font-weight: 700; color: {{ t.gray_900 }};">This week's best deals</h2>
              {% if no_favorite_deals %}
                <p style="margin: 0 0 16px; font-family: {{ t.font }}; font-size: 14px; line-height: 1.5; color: {{ t.gray_500 }};">Your favorite countries came up empty this week, so these are all discoveries. <a href="{{ update_url }}" style="color: {{ t.gray_500 }};">Add more favorites</a> to widen next week's search.</p>
              {% endif %}
              {% for flight in flights %}{{ deal_card(flight) }}{% endfor %}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 24px 0 8px;">
              <p style="margin: 0; font-family: {{ t.font }}; font-size: 20px; font-weight: 700; color: {{ t.gray_900 }};">Happy travels!</p>
            </td>
          </tr>
          <tr>
            <td align="center" style="border-top: 1px solid {{ t.gray_200 }}; padding: 24px 0 48px;">
              <p style="margin: 0; font-family: {{ t.font }}; font-size: 12px; color: {{ t.gray_500 }};">
                <a href="{{ site_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">timonrieger.de</a>
                <a href="{{ unsubscribe_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">Unsubscribe</a>
                <a href="{{ update_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">Update Profile</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

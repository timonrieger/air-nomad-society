<!doctype html>
<html lang="en">
  <body style="margin: 0; background-color: #ffffff; font-family: 'Bitter', Georgia, Times, 'Times New Roman', serif; color: #1e0e4b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 48px 16px;">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width: 480px; text-align: center;">
            <tr>
              <td>
                <h1 style="margin: 0 0 16px; font-size: 28px;">Hi {{ username }}!</h1>
                <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.5; color: #444a5b;">
                  Confirm your subscription to start receiving your weekly
                  flight deals from Air Nomad Society. If you didn't request
                  this, simply ignore this email.
                </p>
                <a href="{{ confirm_url }}" style="display: inline-block; background-color: #7747ff; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 16px; padding: 10px 28px; border-radius: 4px;">Confirm Subscription</a>
                <p style="margin: 28px 0 0; font-size: 12px; color: #888888;">
                  Button not working? Copy this link into your browser:<br />
                  <a href="{{ confirm_url }}" style="color: #7747ff; word-break: break-all;">{{ confirm_url }}</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

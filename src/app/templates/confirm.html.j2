<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>Confirm your subscription</title>
    <!--[if !mso]><!-->
    <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;600;700&display=swap" rel="stylesheet" type="text/css">
    <!--<![endif]-->
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff; font-family: {{ t.font }}; color: {{ t.gray_900 }};">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 48px 16px;">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="max-width: 480px; text-align: center;">
            <tr>
              <td>
                <p style="margin: 0 0 24px; font-size: 14px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: {{ t.accent }};">Air Nomad Society</p>
                <h1 style="margin: 0 0 16px; font-size: 28px; font-weight: 700;">Hi {{ username }}!</h1>
                <p style="margin: 0 0 28px; font-size: 16px; line-height: 1.5; color: {{ t.gray_500 }};">
                  Confirm your subscription to start receiving your weekly
                  flight deals from Air Nomad Society. If you didn't request
                  this, simply ignore this email.
                </p>
                <a href="{{ confirm_url }}" style="display: inline-block; background-color: {{ t.accent }}; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 16px; line-height: 24px; padding: 10px 28px; border-radius: 8px;">Confirm Subscription</a>
                <p style="margin: 28px 0 0; font-size: 12px; color: {{ t.gray_500 }};">
                  Button not working? Copy this link into your browser:<br>
                  <a href="{{ confirm_url }}" style="color: {{ t.accent }}; word-break: break-all;">{{ confirm_url }}</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

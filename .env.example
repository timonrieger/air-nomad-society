# Copy to .env for local development. This one file drives the backend and,
# via vite's envDir, the frontend. The values below are the local defaults;
# production values live in the respective platforms (see README).
# Every field without a value is required — empty counts as unset, and the
# backend refuses to start until all required values are filled in.

# Web app + digest job: any Postgres you run locally
DB_URI=postgresql://ans:ans@localhost:5432/ans

# JWT + confirmation links
SECRET_KEY=local-dev-secret-at-least-32-bytes-ok

# Digest job + confirmation emails
TEQUILA_API_KEY=
SMTP_EMAIL=
SMTP_PWD=
SMTP_SERVER=
SMTP_PORT=587

# Set ENVIRONMENT=dev to restrict the digest to the subscriber with id MY_UUID
ENVIRONMENT=prod
MY_UUID=

# Origin of the frontend: CORS allow-list + base URL for email links.
# Locally that's the vite dev server; in production https://ans.timonrieger.de
PUBLIC_BASE_URL=http://localhost:5173

# Where the frontend reaches the API, baked in at build time.
# Locally that's uvicorn; in production https://api.ans.timonrieger.de
VITE_API_URL=http://localhost:8000

# Copy to .env for local development. All variables are optional at import
# time; each feature fails at the point of use if its values are missing.

# Web app + digest job
DB_URI=postgresql://ans:ans@localhost:5432/ans

# JWT Key
SECRET_KEY=change-me

# Digest job only
TEQUILA_API_KEY=
SMTP_EMAIL=
SMTP_PWD=
SMTP_SERVER=
SMTP_PORT=587

# Set ENVIRONMENT=dev to restrict the digest to the subscriber with id MY_UUID
ENVIRONMENT=prod
MY_UUID=

# Base URL used in email links
PUBLIC_BASE_URL=https://ans.timonrieger.de

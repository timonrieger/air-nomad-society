<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <title>News from Air Nomad Society</title>
  <!--[if !mso]><!-->
  <link href="https://api.fonts.coollabs.io/css2?family=Bitter:wght@400;600;700&display=swap" rel="stylesheet" type="text/css">
  <!--<![endif]-->
</head>

{% from "_macros.html.j2" import eyebrow with context %}

<body style="margin: 0; padding: 0; background-color: #ffffff; -webkit-text-size-adjust: none; text-size-adjust: none;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #ffffff;">
    <tr>
      <td align="center" style="padding: 0 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; text-align: left;">
          <tr>
            <td style="padding: 48px 0 32px;">
              {{ eyebrow() }}
              <h1 style="margin: 0; font-family: {{ t.font }}; font-size: 32px; font-weight: 700; line-height: 1.2; color: {{ t.gray_900 }};">Hi {{ username }}!</h1>
            </td>
          </tr>
          <tr>
            <td>
              {% for paragraph in paragraphs %}
              <p style="margin: 0 0 16px; font-family: {{ t.font }}; font-size: 16px; line-height: 1.5; color: {{ t.gray_800 }};">{{ paragraph }}</p>
              {% endfor %}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding: 24px 0 8px;">
              <p style="margin: 0; font-family: {{ t.font }}; font-size: 20px; font-weight: 700; color: {{ t.gray_900 }};">Happy travels!</p>
            </td>
          </tr>
          <tr>
            <td align="center" style="border-top: 1px solid {{ t.gray_200 }}; padding: 24px 0 48px;">
              <p style="margin: 0; font-family: {{ t.font }}; font-size: 12px; color: {{ t.gray_500 }};">
                <a href="{{ site_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">ans.timonrieger.de</a>
                <a href="{{ unsubscribe_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">Unsubscribe</a>
                <a href="{{ update_url }}" style="color: {{ t.gray_500 }}; text-decoration: none; padding: 0 10px;">Update Profile</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
